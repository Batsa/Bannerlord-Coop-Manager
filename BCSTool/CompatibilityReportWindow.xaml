<Window x:Class="BCSTool.CompatibilityReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BCSTool.Models"
        Title="Coop Compatibility Analysis - Bannerlord Coop Manager"
        Width="1120"
        Height="760"
        MinWidth="850"
        MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="WrappedCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Coop Compatibility Analysis"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock FontSize="15" Margin="0,4,0,0">
                    <Run Text="{Binding ModuleName}" FontWeight="SemiBold"/>
                    <Run Text="  "/>
                    <Run Text="{Binding ModuleId}" Foreground="Gray"/>
                    <Run Text="  "/>
                    <Run Text="{Binding ModuleVersion}" Foreground="Gray"/>
                </TextBlock>
                <TextBlock Text="{Binding ModulePath}" Foreground="Gray" FontSize="11"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ModulePath}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding GeneratedText}"
                       Foreground="Gray" VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="1" Padding="12" Margin="0,0,0,10"
                BorderThickness="1" CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF8E1"/>
                    <Setter Property="BorderBrush" Value="#F9A825"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OverallStatus}"
                                     Value="{x:Static models:CoopCompatibilityStatus.LikelyCompatible}">
                            <Setter Property="Background" Value="#E8F5E9"/>
                            <Setter Property="BorderBrush" Value="#2E7D32"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OverallStatus}"
                                     Value="{x:Static models:CoopCompatibilityStatus.BridgeLikelyRequired}">
                            <Setter Property="Background" Value="#FFF3E0"/>
                            <Setter Property="BorderBrush" Value="#EF6C00"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OverallStatus}"
                                     Value="{x:Static models:CoopCompatibilityStatus.Blocked}">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Setter Property="BorderBrush" Value="#C62828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding StatusSummary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BaselineText}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding InventoryText}" Margin="0,3,0,0" Foreground="Gray"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Findings}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}"
                                     Value="{x:Static models:CompatibilityFindingSeverity.Blocker}">
                            <Setter Property="Background" Value="#FFEBEE"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}"
                                     Value="{x:Static models:CompatibilityFindingSeverity.HighRisk}">
                            <Setter Property="Background" Value="#FFF3E0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}"
                                     Value="{x:Static models:CompatibilityFindingSeverity.Warning}">
                            <Setter Property="Background" Value="#FFFDE7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}"
                                     Value="{x:Static models:CompatibilityFindingSeverity.Pass}">
                            <Setter Property="Background" Value="#F1F8E9"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="95"
                                    ElementStyle="{StaticResource WrappedCell}"/>
                <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="145"
                                    ElementStyle="{StaticResource WrappedCell}"/>
                <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="240"
                                    ElementStyle="{StaticResource WrappedCell}"/>
                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*"
                                    ElementStyle="{StaticResource WrappedCell}"/>
                <DataGridTextColumn Header="Next action" Binding="{Binding Recommendation}" Width="2*"
                                    ElementStyle="{StaticResource WrappedCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Static analysis does not prove server load, client join, save, reconnect, battle, or long-session compatibility."
                       TextWrapping="Wrap" Foreground="#B45F06" VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Copy Report" Click="CopyReport_Click"
                    MinWidth="120" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Close" IsCancel="True" MinWidth="100"/>
        </Grid>
    </Grid>
</Window>
