<Window x:Class="BCSTool.BridgePopulationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bridge Population Settings"
        Width="760"
        Height="680"
        MinWidth="680"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
        <Style x:Key="NumericTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="130"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Restore Defaults"
                    Click="RestoreDefaults_Click" Margin="0,0,8,0"/>
            <TextBlock x:Name="SaveStatusText" Grid.Column="1"
                       Foreground="#2E6B2E" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="4,0,12,0"/>
            <Button Grid.Column="2" Content="Save &amp; Close"
                    Click="SaveAndClose_Click" MinWidth="120" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="Save"
                    Click="Save_Click" MinWidth="82" Margin="0,0,8,0"/>
            <Button Grid.Column="4" Content="Close"
                    Click="Close_Click" MinWidth="82"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Bridge Population Settings"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="BridgeNameText" Margin="0,4,0,0"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="SettingsPathText" Margin="0,2,0,14"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="Gray" TextWrapping="Wrap"/>

                <Border BorderBrush="#D6B656" BorderThickness="1"
                        Background="#FFF8DC" CornerRadius="4" Padding="10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Existing parties are never deleted."/>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                    Text="Caravan and villager values are soft ceilings for future automatic spawns. A ceiling of 0 stops future automatic spawns in that category. Existing global or per-town caravan counts above a ceiling are not trimmed; they fall only through normal campaign attrition. Changes are loaded on the next server start."/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#9BB7D3" BorderThickness="1"
                        Background="#F3F8FC" CornerRadius="4" Padding="10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Calculated native population guide"/>
                        <TextBlock x:Name="PopulationGuideSummaryText"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PopulationGuideSourceText"
                                   Margin="0,3,0,0" Foreground="Gray"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <GroupBox Header="Automatic caravan parties" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Maximum automatic caravans"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource NumericTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseNativeAutomaticCaravanLimit}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                                <TextBox.Text>
                                    <Binding Path="AutomaticCaravanLimit"
                                             UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnExceptions="True"/>
                                </TextBox.Text>
                            </TextBox>
                            <CheckBox Grid.Column="2" Content="Use native behavior"
                                      IsChecked="{Binding UseNativeAutomaticCaravanLimit, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <TextBlock Margin="0,5,0,0" Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Text="Optional global ceiling retained for compatibility. It is enforced together with the per-town ceiling below."/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Automatic NPC caravans per town"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumericTextBox}"
                                     Text="{Binding AutomaticNpcCaravansPerTown, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                            <TextBlock Grid.Column="2" Margin="10,0,0,0"
                                       Foreground="Gray" VerticalAlignment="Center"
                                       Text="0 to 10; default 2"/>
                        </Grid>
                        <TextBlock x:Name="CaravanGuideText" Margin="0,8,0,0"
                                   Foreground="#315D85" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CaravanPerTownGuideText" Margin="0,4,0,0"
                                   Foreground="#315D85" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Villager trade parties" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Maximum active villager parties"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource NumericTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseNativeActiveVillagerPartyLimit}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                                <TextBox.Text>
                                    <Binding Path="ActiveVillagerPartyLimit"
                                             UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnExceptions="True"/>
                                </TextBox.Text>
                            </TextBox>
                            <CheckBox Grid.Column="2" Content="Use native behavior"
                                      IsChecked="{Binding UseNativeActiveVillagerPartyLimit, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <TextBlock x:Name="VillagerGuideText" Margin="0,8,0,0"
                                   Foreground="#315D85" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,8,0,0" Foreground="DarkGoldenrod"
                                   TextWrapping="Wrap"
                                   Text="Villager parties carry food and goods between villages and towns. Aggressive limits can damage markets, workshops, prosperity, and settlement food supplies."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Bandit parties" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Parties around hideouts multiplier"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource NumericTextBox}"
                                 Text="{Binding BanditPartiesAroundHideoutMultiplier, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <TextBlock Grid.Column="2" Margin="10,0,0,0"
                                   Foreground="Gray" VerticalAlignment="Center"
                                   Text="0 to 10; 1 uses native density"/>
                    </Grid>
                </GroupBox>

                <TextBlock Foreground="Gray" TextWrapping="Wrap"
                           Text="Looter limits and wanderer limits remain in Coop Mod Configuration. This bridge editor does not duplicate or override those Coop-owned settings."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
